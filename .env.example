# Supabase Project Credentials
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_PROJECT_REF=<your-project-id>
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_API_KEY=eyJhbGciOiJIUzI1NiIsIn...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsIn...

# Apify (LinkedIn scraping)
APIFY_API_TOKEN=apify_api_...

# Hunter.io (Lead Enrichment)
HUNTER_API_KEY=...

# Tavily
TAVILY_API_KEY=tvly-...

# Groq (Multiple keys for stateless rotation to avoid rate limits)
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=gsk_...
GROQ_API_KEY_3=gsk_...
GROQ_API_KEY_4=gsk_...
GROQ_API_KEY_5=gsk_...

# Modelo Groq único para TODAS las llamadas del pipeline (intent, discovery,
# scoring, validación de rol, email, query planning, parseo ICP en Modo Rápido).
# Antes existían GROQ_MODEL_REASONING/GROQ_MODEL_FAST por separado; se consolidaron
# en una sola variable (ver directivas/09_lead_scoring_engine_SOP.md).
# ATENCIÓN: Groq rota su catálogo de modelos gratuitos con frecuencia — tanto
# llama-4-scout-17b-16e-instruct como, después, llama-3.3-70b-versatile quedaron
# descontinuados/sin acceso. Antes de fijar un nuevo default, verifica el catálogo
# vigente con tus propias keys: curl https://api.groq.com/openai/v1/models
# -H "Authorization: Bearer $GROQ_API_KEY_1"  (confirmado activo 2026-08-25):
GROQ_MODEL=openai/gpt-oss-120b

# CORS (backend FastAPI). CSV de orígenes permitidos; si se omite, se usa "*" sin credenciales.
ALLOWED_ORIGINS=https://tu-frontend.vercel.app

# Internal Backend URL for Status Telemetry Updates
INTERNAL_BACKEND_URL=https://<your-modal-backend-url>.modal.run 

# Backend API Key for secured requests
GLOVAR_BACKEND_API_KEY=YourSecureBackendToken...
