# Supabase Project Credentials
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_PROJECT_REF=<your-project-id>
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_API_KEY=eyJhbGciOiJIUzI1NiIsIn...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsIn...

# Apify (LinkedIn scraping)
APIFY_API_TOKEN=apify_api_...

# Hunter.io (Lead Enrichment)
HUNTER_API_KEY=...

# Apollo.io
# NOTA: la búsqueda en la base global (mixed_people/search) y el enriquecimiento
# (people/match) requieren un plan de pago con "API access" habilitado. Si tu plan
# no lo permite, el Modo Rápido usa automáticamente el fallback Tavily + Hunter.
APOLLO_API_KEY=...

# Tavily
TAVILY_API_KEY=tvly-...

# Groq (Multiple keys for stateless rotation to avoid rate limits)
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=gsk_...
GROQ_API_KEY_3=gsk_...
GROQ_API_KEY_4=gsk_...
GROQ_API_KEY_5=gsk_...

# Groq model selection (Auditoría #8 — afinable sin tocar código).
# Por defecto usan Llama-4-Scout. GROQ_MODEL_REASONING para tareas cognitivas
# (intent, scoring, validación de roles, emails); GROQ_MODEL_FAST para tareas simples.
GROQ_MODEL_REASONING=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_FAST=meta-llama/llama-4-scout-17b-16e-instruct

# CORS (backend FastAPI). CSV de orígenes permitidos; si se omite, se usa "*" sin credenciales.
ALLOWED_ORIGINS=https://tu-frontend.vercel.app

# Internal Backend URL for Status Telemetry Updates
INTERNAL_BACKEND_URL=https://<your-modal-backend-url>.modal.run 

# Glovar Backend API Key for secured requests
GLOVAR_BACKEND_API_KEY=YourSecureBackendToken...
